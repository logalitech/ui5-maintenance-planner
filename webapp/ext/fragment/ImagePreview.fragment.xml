<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:grid="sap.ui.layout.cssgrid">
    <VBox core:require="{ handler: 'sapui5/maintenanceplanner/ext/fragment/ImagePreview' }">
        <f:GridList
            id="imagePreviewGrid"
            items="{_Attachment}"
            noDataText="{i18n>imagePreviewNoImages}"
            updateFinished="handler.onAttachmentsUpdateFinished">
            <f:customLayout>
                <grid:GridBoxLayout boxWidth="10rem"/>
            </f:customLayout>
            <f:GridListItem visible="{ path: 'MimeType', targetType: 'any', formatter: 'handler.isImage' }">
                <VBox class="sapUiSmallMargin">
                    <Image
                        src="{Attachment}"
                        alt="{FileName}"
                        decorative="false"
                        densityAware="false"
                        lazyLoading="true"
                        width="100%">
                        <detailBox>
                            <LightBox>
                                <LightBoxItem
                                    imageSrc="{Attachment}"
                                    title="{FileName}"
                                    subtitle="{AttComment}"
                                    alt="{FileName}"/>
                            </LightBox>
                        </detailBox>
                    </Image>
                    <Text text="{FileName}" maxLines="2" class="sapUiTinyMarginTop"/>
                </VBox>
            </f:GridListItem>
        </f:GridList>
        <Text id="imagePreviewNoImages" text="{i18n>imagePreviewNoImages}" visible="false"/>
    </VBox>
</core:FragmentDefinition>
